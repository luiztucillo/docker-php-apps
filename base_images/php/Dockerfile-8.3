FROM phpdockerio/php:8.3-fpm

ENV PHP_VERSION=8.3
# First Ondřej Surý PPA revision with the fix for CVE-2026-109618 / CVE-2026-109619
ENV PHP_MIN_REVISION=8.3.36
ENV PHP_CONFIG_PATH=/etc/php/8.3
ENV PACKAGES="vim golang-go git subversion mysql-client php8.3-memcached php8.3-mysql php8.3-intl php8.3-redis php8.3-xdebug php8.3-bcmath php8.3-gd php8.3-soap"
ENV PHPUNIT_URL="https://phar.phpunit.de/phpunit-10.phar"
ENV GLOBAL_PATH=/usr/local/bin

# Fix debconf warnings upon build
ARG DEBIAN_FRONTEND=noninteractive

# Install selected extensions and other stuff
# update and install share a layer so a cached package index never pins an old PHP;
# fpm and cli are listed so apt upgrades them even if the base image is stale
RUN apt-get update \
    && apt-get -y --no-install-recommends install php${PHP_VERSION}-fpm php${PHP_VERSION}-cli $PACKAGES \
    && apt-get clean; rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/* /usr/share/doc/*

# Fail the build if apt resolved a PHP revision without the security fix
RUN for p in php${PHP_VERSION}-fpm php${PHP_VERSION}-cli; do \
        v="$(dpkg-query -W -f='${Version}' $p)"; \
        dpkg --compare-versions "$v" ge "$PHP_MIN_REVISION" \
            || { echo "$p $v is older than $PHP_MIN_REVISION" >&2; exit 1; }; \
    done

# Configure
COPY conf/php.ini $PHP_CONFIG_PATH/fpm/
COPY conf/php.ini $PHP_CONFIG_PATH/cli/
COPY conf/php-fpm-8.3.conf $PHP_CONFIG_PATH/fpm/

RUN mkdir -p /var/www/html

### Install sendmail for use with mailhog
ENV GOPATH /tmp
RUN cd /tmp \
    && go install github.com/mailhog/mhsendmail@v0.2.0 \
    && cp /tmp/bin/mhsendmail /usr/local/bin

#Install and configure PHPCS
RUN curl -L https://squizlabs.github.io/PHP_CodeSniffer/phpcs.phar -o $GLOBAL_PATH/phpcs \
    && chmod +x $GLOBAL_PATH/phpcs

#Install PHPUnit
RUN curl -L $PHPUNIT_URL -o $GLOBAL_PATH/phpunit.phar \
    && chmod +x $GLOBAL_PATH/phpunit.phar \
    && ln -sf $GLOBAL_PATH/phpunit.phar $GLOBAL_PATH/phpunit

# Make sure the volume mount point is empty
RUN rm -rf /var/www/html/*
WORKDIR /var/www/html
